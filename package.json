{
  "name": "nextjs-serverless-async-handler",
  "version": "1.0.0",
  "description": "A robust pattern and utility for handling background tasks in Next.js serverless environments using the native after() API to prevent silent execution drops.",
  "author": "Meshari Alotaibe",
  "license": "MIT",
  "type": "module",
  "main": "./dist/safe-after.js",
  "types": "./dist/safe-after.d.ts",
  "exports": {
    ".": {
      "types": "./dist/safe-after.d.ts",
      "import": "./dist/safe-after.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eng-Meshari/nextjs-serverless-async-handler.git"
  },
  "homepage": "https://github.com/Eng-Meshari/nextjs-serverless-async-handler#readme",
  "bugs": {
    "url": "https://github.com/Eng-Meshari/nextjs-serverless-async-handler/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "next": ">=16.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "next": "^16.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "nextjs",
    "serverless",
    "background-tasks",
    "after",
    "typescript"
  ]
}
